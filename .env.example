# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL in Docker/Prod, SQLite support for test harness)
DATABASE_URL=postgresql+psycopg://auth_user:auth_secure_pass@localhost:5432/auth_db
TEST_DATABASE_URL=sqlite:///./test_auth.db

# Redis Configuration
REDIS_URL=redis://:redis_secure_pass@localhost:6379/0
TEST_REDIS_URL=redis://:redis_secure_pass@localhost:6379/1

# Security & Cryptography
# High-entropy HMAC keys mapped by version. In production, 32-byte hex strings.
OTP_HMAC_KEYS={"v1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
OTP_HMAC_CURRENT_KEY_VERSION=v1
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_characters_long_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# OTP Challenge Policies
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Rate Limiting Policies
RATE_LIMIT_PHONE_MAX=3
RATE_LIMIT_PHONE_WINDOW_SECONDS=900
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_IP_WINDOW_SECONDS=900
RATE_LIMIT_DAILY_PHONE_MAX=10

# SMS Provider Configuration
# Supported providers: mock, twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE=

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_PROXY_IPS=127.0.0.1,::1
